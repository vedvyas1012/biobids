PORT=5001
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=biomass_platform
JWT_SECRET=replace_with_random_32_char_string
JWT_REFRESH_SECRET=replace_with_another_random_32_char_string

# Escrow.com API
# Create an account at https://www.escrow-sandbox.com (sandbox) or https://www.escrow.com (production)
# Go to Account Settings → API Keys → Generate new key
ESCROW_EMAIL=your_escrow_account_email@example.com
ESCROW_API_KEY=your_escrow_api_key_here
# Sandbox: https://api.escrow-sandbox.com/2017-09-01
# Production: https://api.escrow.com/2017-09-01
ESCROW_BASE_URL=https://api.escrow-sandbox.com/2017-09-01
ESCROW_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
# Optional: explicit buyer-facing web base URL for payment links.
# If unset, derived automatically from ESCROW_BASE_URL (sandbox → escrow-sandbox.com, else escrow.com).
ESCROW_WEB_BASE_URL=
# INR to USD conversion rate for Escrow.com transaction amounts (update monthly or when rate moves >2%)
ESCROW_INR_USD_RATE=83

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
CLIENT_URL=http://localhost:3000
NODE_ENV=development
